        "FADAPlaybackSession and FADAPlaybackController",
        "SupportBoundContextPolicy and FrozenIDMSupportQueryPolicy",
        "Planner, Tracker encoder/decoder, Context Encoder, and wrapper Action consumer"
      ],
      "simplifications": [
        "one deterministic environment row",
        "two control cycles, the minimum state-creation and later-consumption horizon",
